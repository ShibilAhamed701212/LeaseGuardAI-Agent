# Copy to .env and fill in real values

# PostgreSQL (REQUIRED) — port 5433 is the host-mapped port from Docker
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=ocr_agent
PG_USER=postgres
PG_PASSWORD=postgres
PG_SSL=false

# Redis — port 6380 is the host-mapped port from Docker
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false
# Alternatively set REDIS_URL=redis://... (or rediss:// for TLS); it takes precedence over HOST/PORT

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ocr-agent

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ocr-process
N8N_SECRET=your-n8n-secret

# App
SIGNED_URL_EXPIRY_SECONDS=3600
REDIS_RESULT_TTL_SECONDS=86400

# Server
PORT=10000

# Google Gemini (required for analysis and /chat)
GEMINI_API_KEY=
